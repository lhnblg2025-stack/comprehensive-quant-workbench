[Unit]
Description=MuYun Tianshu daily rolling data update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
Group=quant
RuntimeDirectory=quant
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/quant/current
EnvironmentFile=-/etc/quant/quant.env
Environment=QUANT_ROOT=/opt/quant/current
Environment=QUANT_REPORT_ROOT=/opt/quant/shared/reports
Environment=QUANT_LOCK_DIR=/run/quant
ExecStart=/opt/quant/venv/bin/python -u /opt/quant/current/scripts/rolling_data_update.py --domains kline,industry,industry_chain --retries 2
TimeoutStartSec=7200
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/quant/current /opt/quant/shared /opt/quant/config /opt/quant/generated /opt/quant/logs /opt/quant/data_warehouse /run/quant

[Install]
WantedBy=multi-user.target
