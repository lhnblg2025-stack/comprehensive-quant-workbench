# Copy to /etc/quant/quant.env on Tencent Cloud, chmod 600.
# Never commit the real file.
QUANT_ROOT=/opt/quant/current
QUANT_PYTHON=/opt/quant/venv/bin/python
QUANT_REPORT_ROOT=/opt/quant/shared/reports
QUANT_LOCK_DIR=/run/quant
QUANT_WEB_BIND_HOST=127.0.0.1
QUANT_WEB_PORT=8600
QUANT_WEB_API_KEY=replace-with-a-long-random-secret
# Keep this unset/0 in production. Local start_quant.sh sets it only for loopback.
QUANT_WEB_ALLOW_UNAUTH=0
PYTHONUNBUFFERED=1
# Optional integrations:
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_CHAT_ID=
# YOUDAONOTE_API_KEY=
