{
  "experiment_name": "ashare_qlib_factor_research",
  "framework": "microsoft_qlib",
  "provider_uri": "data_warehouse/research_panels/ashare_tushare_500_10y_v2",
  "handler": {
    "class": "quant_system.qlib_handler.ASharePITHandler",
    "module_path": "quant_system"
  },
  "dataset": {
    "class": "DatasetH",
    "module_path": "qlib.data.dataset",
    "kwargs": {
      "segments": {
        "train": ["2016-01-04", "2020-12-31"],
        "valid": ["2021-01-01", "2022-12-31"],
        "test": ["2023-01-01", "2026-08-31"]
      }
    }
  },
  "model": {
    "class": "LGBModel",
    "module_path": "qlib.contrib.model.gbdt",
    "kwargs": {
      "loss": "mse",
      "colsample_bytree": 0.8,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "lambda_l1": 200,
      "lambda_l2": 500,
      "max_depth": 8,
      "num_threads": 4,
      "num_boost_round": 500
    }
  },
  "strategy": {
    "class": "TopkDropoutStrategy",
    "module_path": "qlib.contrib.strategy",
    "kwargs": {
      "topk": 50,
      "n_drop": 5
    }
  },
  "backtest": {
    "exchange_kwargs": {
      "freq": "day",
      "limit_threshold": 0.1,
      "deal_price": "open",
      "open_cost": 0.000085,
      "close_cost": 0.000585,
      "min_cost": 5,
      "account": 1000000,
      "benchmark": "SH000300"
    }
  },
  "notes": [
    "Qlib is the research/factor/model/backtest authority.",
    "A-share PIT and trade-state fields are supplied by our adapter.",
    "Backtrader is optional order-level execution reconciliation only.",
    "Do not promote strategies without authoritative historical trade state."
  ]
}
